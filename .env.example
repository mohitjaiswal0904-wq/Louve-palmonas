# Louve — environment variables (example).
# Copy to .env.local for Next.js runtime, or .env for Prisma CLI tooling.
# NEVER commit real credentials.

# Node runtime mode. Next.js sets this automatically for dev/build/start;
# only override in tests or custom hosts.
NODE_ENV=development

# PostgreSQL connection string used by Prisma Client and `prisma migrate`.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/louve?schema=public"
